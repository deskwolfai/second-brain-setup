      }
    },
    "Work": {
      "space_id": "<space_id>",
      "lists": {
        "ADMIN": "<list_id>",
        "FULFILLMENT": "<list_id>",
        "MARKETING": "<list_id>"
      }
    },
    "Inbox": {
      "space_id": "<space_id>",
      "lists": {
        "Quick Capture": "<list_id>"
      }
    }
  }
}
