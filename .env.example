# KAGE — credentials
#
# Copy this file to `.env` in this same folder, then fill in your values.
# After bootstrap, this same file should also exist (or be symlinked) at
# ~/.claude/skills/kage/.env so the installed skill can find it.
#
# Precedence: process env vars > skill-local .env > repo-local .env

# ─────────────────────────────────────────────────────────────────────
# ClickUp (required if you're using the GAMBATTE side of KAGE)
# ─────────────────────────────────────────────────────────────────────

# Your personal ClickUp API token.
# Get it from: ClickUp avatar → Settings → Apps → API Token
# Paste the literal `pk_...` value — NO "Bearer " prefix.
CLICKUP_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxx

# Your ClickUp workspace (team) ID.
# Find it in any ClickUp URL: https://app.clickup.com/<team_id>/v/...
# Or run: python ~/.claude/skills/kage/scripts/clickup.py teams
CLICKUP_TEAM_ID=

# (Optional) Override the manifest location.
# Defaults to ~/.claude/skills/kage/manifest.json.
# CLICKUP_MANIFEST=/absolute/path/to/manifest.json

# ─────────────────────────────────────────────────────────────────────
# Obsidian BUNSHIN vault (optional)
# ─────────────────────────────────────────────────────────────────────

# Absolute path to your Obsidian vault folder.
# Leave unset if you don't use Obsidian — the ClickUp half works alone.
# Use forward slashes even on Windows: C:/Users/yourname/Documents/MyVault
# BUNSHIN_VAULT=
